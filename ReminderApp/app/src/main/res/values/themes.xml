<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 无系统标题栏：主页自绘顶部栏，其它页面使用 MaterialToolbar -->
    <style name="Theme.Reminder" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
        <item name="materialCardViewStyle">@style/Widget.Reminder.Card</item>
        <item name="textInputStyle">@style/Widget.Reminder.TextInput</item>
        <item name="toolbarStyle">@style/Widget.Reminder.Toolbar</item>
    </style>

    <!-- 白色圆角卡片 + 细边框，无阴影 -->
    <style name="Widget.Reminder.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.Reminder.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.Reminder.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg</item>
        <item name="titleCentered">true</item>
        <item name="titleTextAppearance">@style/TextAppearance.Reminder.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.Reminder.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- 胶囊形筛选标签：选中黑底白字，未选中浅灰底 -->
    <style name="Widget.Reminder.PillChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">38dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Reminder.Pill</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ShapeAppearance.Reminder.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 统计卡片文字 -->
    <style name="TextAppearance.Reminder.StatLabel" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Reminder.StatValue" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.Reminder.StatSub" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
